    "# ============================================\n",
    "# STAGE 5 - STEP 6\n",
    "# TRAINING-ONLY CRPI WEIGHT SELECTION\n",
    "# ============================================\n",
    "\n",
    "from sklearn.metrics import roc_auc_score\n",
    "\n",
    "# --------------------------------------------\n",
    "# Build training component data\n",
    "# --------------------------------------------\n",
    "\n",
    "# Training customer IDs\n",
    "stage5_train_ids = (\n",
    "    hybrid_customer_ids.iloc[\n",
    "        hybrid_train_idx\n",
    "    ]\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "# Training hybrid churn probability\n",
    "train_churn_data = pd.DataFrame({\n",
    "    \"customer_unique_id\": stage5_train_ids,\n",
    "    \"churn_risk\": hybrid_train_proba\n",
    "})\n",
    "\n",
    "# Training CLV\n",
    "train_clv_data = stage5_data[\n",
    "    [\n",
    "        \"customer_unique_id\",\n",
    "        \"clv_proxy\"\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "# Training drift\n",
    "train_drift_data = drift_final[\n",
    "    [\n",
    "        \"customer_unique_id\",\n",
    "        \"drift_severity\"\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "# Training target\n",
    "train_target_data = pd.DataFrame({\n",
    "    \"customer_unique_id\": stage5_train_ids,\n",
    "    \"actual_churn\": hybrid_y_train\n",
    "})\n",
    "\n",
    "# Merge\n",
    "crpi_train = (\n",
    "    train_churn_data\n",
    "    .merge(\n",
    "        train_clv_data,\n",
    "        on=\"customer_unique_id\",\n",
    "        how=\"inner\",\n",
    "        validate=\"one_to_one\"\n",
    "    )\n",
    "    .merge(\n",
    "        train_drift_data,\n",
    "        on=\"customer_unique_id\",\n",
    "        how=\"inner\",\n",
    "        validate=\"one_to_one\"\n",
    "    )\n",
    "    .merge(\n",
    "        train_target_data,\n",
    "        on=\"customer_unique_id\",\n",
    "        how=\"inner\",\n",
    "        validate=\"one_to_one\"\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"CRPI training dataset shape:\")\n",
    "print(crpi_train.shape)\n",
    "\n",
    "print(\"\\nTarget distribution:\")\n",
    "print(\n",
    "    crpi_train[\"actual_churn\"].value_counts()\n",
    ")\n",
    "\n",
    "# --------------------------------------------\n",
    "# Normalize training components\n",
    "# IMPORTANT:\n",
    "# scalers are fitted on training only\n",
    "# --------------------------------------------\n",
    "\n",
    "train_churn_scaler = MinMaxScaler()\n",
    "train_clv_scaler = MinMaxScaler()\n",
    "train_drift_scaler = MinMaxScaler()\n",
    "\n",
    "crpi_train[\"churn_norm\"] = (\n",
    "    train_churn_scaler.fit_transform(\n",
    "        crpi_train[[\"churn_risk\"]]\n",
    "    ).ravel()\n",
    ")\n",
    "\n",
    "# Log transform CLV before normalization\n",
    "crpi_train[\"clv_log\"] = np.log1p(\n",
    "    crpi_train[\"clv_proxy\"]\n",
    ")\n",
    "\n",
    "crpi_train[\"clv_norm\"] = (\n",
    "    train_clv_scaler.fit_transform(\n",
    "        crpi_train[[\"clv_log\"]]\n",
    "    ).ravel()\n",
    ")\n",
    "\n",
    "crpi_train[\"drift_norm\"] = (\n",
    "    train_drift_scaler.fit_transform(\n",
    "        crpi_train[[\"drift_severity\"]]\n",
    "    ).ravel()\n",
    ")\n",
    "\n",
    "# --------------------------------------------\n",
    "# Candidate weight combinations\n",
    "# --------------------------------------------\n",
    "\n",
    "candidate_weights = [\n",
    "    (\"Equal\", 1/3, 1/3, 1/3),\n",
    "    (\"Churn-dominant-1\", 0.50, 0.30, 0.20),\n",
    "    (\"Churn-dominant-2\", 0.60, 0.25, 0.15),\n",
    "    (\"Churn-dominant-3\", 0.70, 0.20, 0.10),\n",
    "    (\"Churn-dominant-4\", 0.75, 0.15, 0.10)\n",
    "]\n",
    "\n",
    "weight_results = []\n",
    "\n",
    "for name, w_churn, w_clv, w_drift in candidate_weights:\n",
    "\n",
    "    score = (\n",
    "        w_churn * crpi_train[\"churn_norm\"]\n",
    "        +\n",
    "        w_clv * crpi_train[\"clv_norm\"]\n",
    "        +\n",
    "        w_drift * crpi_train[\"drift_norm\"]\n",
    "    )\n",
    "\n",
    "    auc = roc_auc_score(\n",
    "        crpi_train[\"actual_churn\"],\n",
    "        score\n",
    "    )\n",
    "\n",
    "    weight_results.append({\n",
    "        \"weight_scheme\": name,\n",
    "        \"churn_weight\": w_churn,\n",
    "        \"clv_weight\": w_clv,\n",
    "        \"drift_weight\": w_drift,\n",
    "        \"training_roc_auc\": auc\n",
    "    })\n",
    "\n",
    "weight_results_df = (\n",
    "    pd.DataFrame(weight_results)\n",
    "    .sort_values(\n",
    "        \"training_roc_auc\",\n",
    "        ascending=False\n",
    "    )\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "print(\"\\nTraining-only CRPI weight comparison:\")\n",
    "display(\n",
    "    weight_results_df.round(4)\n",
    ")\n",
    "\n",
    "# --------------------------------------------\n",
    "# Select best training-only weights\n",
    "# --------------------------------------------\n",
    "\n",
    "best_weights = (\n",
    "    weight_results_df.iloc[0]\n",
    ")\n",
    "\n",
    "BEST_CHURN_WEIGHT = float(\n",
    "    best_weights[\"churn_weight\"]\n",
    ")\n",
    "\n",
    "BEST_CLV_WEIGHT = float(\n",
    "    best_weights[\"clv_weight\"]\n",
    ")\n",
    "\n",
    "BEST_DRIFT_WEIGHT = float(\n",
    "    best_weights[\"drift_weight\"]\n",
    ")\n",
    "\n",
    "print(\"\\nSelected CRPI weights:\")\n",
    "print(\n",
    "    \"Churn:\",\n",
    "    BEST_CHURN_WEIGHT\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"CLV:\",\n",
    "    BEST_CLV_WEIGHT\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Drift:\",\n",
    "    BEST_DRIFT_WEIGHT\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nSelected scheme:\",\n",
    "    best_weights[\"weight_scheme\"]\n",
    ")"
   ]
  },
