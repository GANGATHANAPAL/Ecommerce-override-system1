    "        _, logits = gru_model(\n",
    "            batch_x,\n",
    "            batch_lengths\n",
    "        )\n",
    "\n",
    "        losses = criterion(\n",
    "            logits,\n",
    "            batch_y\n",
    "        )\n",
    "\n",
    "        sample_weights = torch.where(\n",
    "            batch_y == 0,\n",
    "            torch.full_like(\n",
    "                batch_y,\n",
    "                return_weight\n",
    "            ),\n",
    "            torch.ones_like(batch_y)\n",
    "        )\n",
    "\n",
    "        loss = (\n",
    "            losses * sample_weights\n",
    "        ).mean()\n",
    "\n",
    "        loss.backward()\n",
    "\n",
    "        # Prevent exploding gradients\n",
    "        torch.nn.utils.clip_grad_norm_(\n",
    "            gru_model.parameters(),\n",
    "            max_norm=1.0\n",
    "        )\n",
    "\n",
    "        optimizer.step()\n",
    "\n",
    "        total_loss += (\n",
    "            loss.item() * len(batch_y)\n",
    "        )\n",
    "\n",
    "        total_samples += len(batch_y)\n",
    "\n",
    "    train_loss = (\n",
    "        total_loss / total_samples\n",
    "    )\n",
    "\n",
    "    # ----------------------------------------\n",
    "    # Validation\n",
    "    # ----------------------------------------\n",
    "\n",
    "    gru_model.eval()\n",
    "\n",
    "    val_probabilities = []\n",
    "    val_targets = []\n",
    "\n",
    "    with torch.no_grad():\n",
    "\n",
    "        for batch_x, batch_lengths, batch_y in val_loader:\n",
    "\n",
    "            batch_x = batch_x.to(device)\n",
    "            batch_lengths = batch_lengths.to(device)\n",
    "\n",
    "            _, logits = gru_model(\n",
    "                batch_x,\n",
    "                batch_lengths\n",
    "            )\n",
    "\n",
    "            probabilities = torch.sigmoid(logits)\n",
    "\n",
    "            val_probabilities.extend(\n",
    "                probabilities.cpu().numpy()\n",
    "            )\n",
    "\n",
    "            val_targets.extend(\n",
    "                batch_y.numpy()\n",
    "            )\n",
    "\n",
    "    val_probabilities = np.asarray(\n",
    "        val_probabilities\n",
    "    )\n",
    "\n",
    "    val_targets = np.asarray(\n",
    "        val_targets\n",
    "    )\n",
    "\n",
    "    val_auc = roc_auc_score(\n",
    "        val_targets,\n",
    "        val_probabilities\n",
    "    )\n",
    "\n",
    "    training_history.append({\n",
    "        \"epoch\": epoch,\n",
    "        \"train_loss\": train_loss,\n",
    "        \"val_roc_auc\": val_auc\n",
    "    })\n",
    "\n",
    "    print(\n",
    "        f\"Epoch {epoch:02d}/{MAX_EPOCHS} \"\n",
    "        f\"| Train Loss: {train_loss:.4f} \"\n",
    "        f\"| Val ROC-AUC: {val_auc:.4f}\"\n",
    "    )\n",
    "\n",
    "    # ----------------------------------------\n",
    "    # Early stopping\n",
    "    # ----------------------------------------\n",
    "\n",
    "    if val_auc > best_val_auc:\n",
    "\n",
    "        best_val_auc = val_auc\n",
    "\n",
    "        best_state = copy.deepcopy(\n",
    "            gru_model.state_dict()\n",
    "        )\n",
    "\n",
    "        epochs_without_improvement = 0\n",
    "\n",
    "    else:\n",
    "\n",
    "        epochs_without_improvement += 1\n",
    "\n",
    "        if epochs_without_improvement >= PATIENCE:\n",
    "\n",
    "            print(\n",
    "                f\"\\nEarly stopping triggered \"\n",
    "                f\"after {epoch} epochs.\"\n",
    "            )\n",
    "\n",
    "            break\n",
    "\n",
    "# --------------------------------------------\n",
    "# Restore best model\n",
    "# --------------------------------------------\n",
    "\n",
    "if best_state is not None:\n",
    "    gru_model.load_state_dict(best_state)\n",
    "\n",
    "print(\"\\nGRU training completed.\")\n",
    "\n",
    "print(\n",
    "    \"Best validation ROC-AUC:\",\n",
    "    round(best_val_auc, 4)\n",
    ")"
   ]
