    "# ============================================\n",
    "# STAGE 5 - STEP 2\n",
    "# BUILD FINAL CRPI INPUT DATA\n",
    "# ============================================\n",
    "\n",
    "# Validation customer IDs\n",
    "stage5_validation_ids = (\n",
    "    hybrid_customer_ids.iloc[\n",
    "        hybrid_val_idx\n",
    "    ]\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "# Create churn-risk table\n",
    "hybrid_churn_validation = pd.DataFrame({\n",
    "    \"customer_unique_id\": stage5_validation_ids,\n",
    "    \"final_churn_probability\": hybrid_val_proba\n",
    "})\n",
    "\n",
    "# Get drift information\n",
    "drift_validation = drift_final[\n",
    "    [\n",
    "        \"customer_unique_id\",\n",
    "        \"drift_severity\",\n",
    "        \"high_drift\"\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "# Get CLV information\n",
    "clv_validation = stage5_data[\n",
    "    [\n",
    "        \"customer_unique_id\",\n",
    "        \"clv_proxy\"\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "# Merge all three components\n",
    "stage5_validation_data = (\n",
    "    hybrid_churn_validation\n",
    "    .merge(\n",
    "        clv_validation,\n",
    "        on=\"customer_unique_id\",\n",
    "        how=\"inner\",\n",
    "        validate=\"one_to_one\"\n",
    "    )\n",
    "    .merge(\n",
    "        drift_validation,\n",
    "        on=\"customer_unique_id\",\n",
    "        how=\"inner\",\n",
    "        validate=\"one_to_one\"\n",
    "    )\n",
    ")\n",
