    "import pandas as pd\n",
    "import numpy as np\n",
    "import os\n",
    "\n",
    "PROCESSED_PATH = \"../data/processed\"\n",
    "\n",
    "# Load the observation-period order data\n",
    "observation_orders = pd.read_csv(\n",
    "    os.path.join(\n",
    "        PROCESSED_PATH,\n",
    "        \"observation_orders.csv\"\n",
    "    )\n",
    ")\n",
    "\n",
    "# Convert timestamp\n",
    "observation_orders[\"order_purchase_timestamp\"] = pd.to_datetime(\n",
    "    observation_orders[\"order_purchase_timestamp\"]\n",
    ")\n",
    "\n",
    "# Sort chronologically within each customer\n",
    "observation_orders = observation_orders.sort_values(\n",
    "    [\n",
    "        \"customer_unique_id\",\n",
    "        \"order_purchase_timestamp\"\n",
    "    ]\n",
    ").reset_index(drop=True)\n",
    "\n",
    "print(\"Observation orders loaded successfully.\")\n",
    "print(\"Shape:\", observation_orders.shape)\n",
    "\n",
    "print(\"\\nDate range:\")\n",
    "print(\n",
    "    observation_orders[\"order_purchase_timestamp\"].min(),\n",
    "    \"to\",\n",
    "    observation_orders[\"order_purchase_timestamp\"].max()\n",
    ")\n",
    "\n",
    "print(\"\\nNumber of customers:\")\n",
