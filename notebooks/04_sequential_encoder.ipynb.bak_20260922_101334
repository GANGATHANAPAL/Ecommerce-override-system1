    "\n",
    "# ============================================\n",
    "# STAGE 2 - STEP 2\n",
    "# CREATE EVENT-LEVEL BEHAVIOR FEATURES\n",
    "# ============================================\n",
    "\n",
    "# Calculate time since previous purchase for each customer\n",
    "observation_orders[\"previous_purchase\"] = (\n",
    "    observation_orders\n",
    "    .groupby(\"customer_unique_id\")[\n",
    "        \"order_purchase_timestamp\"\n",
    "    ]\n",
    "    .shift(1)\n",
    ")\n",
    "\n",
    "observation_orders[\"time_since_previous_order_days\"] = (\n",
    "    observation_orders[\"order_purchase_timestamp\"]\n",
    "    - observation_orders[\"previous_purchase\"]\n",
    ").dt.total_seconds() / (60 * 60 * 24)\n",
    "\n",
    "# First event has no previous purchase\n",
    "observation_orders[\n",
    "    \"time_since_previous_order_days\"\n",
    "] = observation_orders[\n",
    "    \"time_since_previous_order_days\"\n",
    "].fillna(0)\n",
    "\n",
    "# Selected event features\n",
    "sequence_feature_columns = [\n",
    "    \"total_items\",\n",
    "    \"total_spending_items\",\n",
    "    \"total_products\",\n",
    "    \"total_sellers\",\n",
    "    \"total_payment\",\n",
    "    \"avg_installments\",\n",
    "    \"avg_review_score\",\n",
    "    \"time_since_previous_order_days\"\n",
    "]\n",
    "\n",
    "print(\"Sequential event features created.\")\n",
    "\n",
    "print(\"\\nFeature columns:\")\n",
    "print(sequence_feature_columns)\n",
    "\n",
    "print(\"\\nMissing values:\")\n",
    "print(\n",
    "    observation_orders[\n",
    "        sequence_feature_columns\n",
    "    ].isnull().sum()\n",
    ")\n",
    "\n",
    "print(\"\\nStatistics:\")\n",
    "display(\n",
    "    observation_orders[\n",
    "        sequence_feature_columns\n",
    "    ].describe().round(3)\n",
    ")"
   ]
