    "# ============================================\n",
    "# STAGE 3 - STEP 3\n",
    "# EXTRACT EVENT HIDDEN STATES\n",
    "# AND CALCULATE EMBEDDING DRIFT\n",
    "# ============================================\n",
    "\n",
    "gru_state_model.eval()\n",
    "\n",
    "event_hidden_states = []\n",
    "final_embeddings = []\n",
    "\n",
    "# Process repeat-customer sequences in batches\n",
    "state_dataset = TensorDataset(\n",
    "    repeat_sequence_tensor,\n",
    "    repeat_length_tensor\n",
    ")\n",
    "\n",
    "state_loader = DataLoader(\n",
    "    state_dataset,\n",
    "    batch_size=128,\n",
    "    shuffle=False\n",
    ")\n",
    "\n",
    "with torch.no_grad():\n",
    "\n",
    "    for batch_x, batch_lengths in state_loader:\n",
    "\n",
    "        batch_x = batch_x.to(device)\n",
    "        batch_lengths = batch_lengths.to(device)\n",
    "\n",
    "        hidden_states, final_embedding, _ = (\n",
    "            gru_state_model(\n",
    "                batch_x,\n",
    "                batch_lengths\n",
    "            )\n",
    "        )\n",
    "\n",
    "        event_hidden_states.extend(\n",
    "            [\n",
    "                h.cpu().numpy()\n",
    "                for h in hidden_states\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        final_embeddings.extend(\n",
    "            final_embedding.cpu().numpy()\n",
    "        )\n",
    "\n",
    "print(\"Event-level hidden states extracted.\")\n",
    "\n",
    "print(\n",
    "    \"Number of customers:\",\n",
    "    len(event_hidden_states)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# Calculate per-customer embedding drift\n",
    "# ------------------------------------------------\n",
    "\n",
    "embedding_drift_scores = []\n",
    "\n",
    "for i, hidden_sequence in enumerate(\n",
    "    event_hidden_states\n",
    "):\n",
    "\n",
    "    seq_len = int(\n",
    "        repeat_lengths[i]\n",
    "    )\n",
    "\n",
    "    # Keep only real events\n",
    "    valid_states = hidden_sequence[:seq_len]\n",
    "\n",
    "    # Split sequence into earlier and recent parts\n",
    "    split_point = max(\n",
    "        1,\n",
    "        seq_len // 2\n",
    "    )\n",
    "\n",
    "    early_states = valid_states[:split_point]\n",
    "    recent_states = valid_states[split_point:]\n",
    "\n",
    "    # For safety\n",
    "    if len(recent_states) == 0:\n",
    "        recent_states = valid_states[-1:]\n",
    "\n",
    "    # Mean embedding for each period\n",
    "    early_embedding = early_states.mean(\n",
    "        axis=0\n",
    "    )\n",
    "\n",
    "    recent_embedding = recent_states.mean(\n",
    "        axis=0\n",
    "    )\n",
    "\n",
    "    # Euclidean embedding shift\n",
    "    drift_distance = np.linalg.norm(\n",
    "        recent_embedding - early_embedding\n",
    "    )\n",
    "\n",
    "    embedding_drift_scores.append(\n",
    "        drift_distance\n",
    "    )\n",
    "\n",
    "embedding_drift_scores = np.asarray(\n",
    "    embedding_drift_scores,\n",
    "    dtype=np.float32\n",
    ")\n",
    "\n",
    "print(\"\\nEmbedding drift signal created.\")\n",
    "\n",
    "print(\"\\nShape:\")\n",
    "print(embedding_drift_scores.shape)\n",
    "\n",
    "print(\"\\nDrift signal statistics:\")\n",
    "print(\n",
    "    pd.Series(\n",
    "        embedding_drift_scores\n",
    "    ).describe().round(4)\n",
    ")"
   ]
