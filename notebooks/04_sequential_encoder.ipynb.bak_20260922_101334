    "# ============================================\n",
    "# STAGE 2 - STEP 10\n",
    "# DEFINE GRU SEQUENTIAL BEHAVIOUR ENCODER\n",
    "# ============================================\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from torch.nn.utils.rnn import pack_padded_sequence\n",
    "\n",
    "\n",
    "class BehaviourGRU(nn.Module):\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        input_size=8,\n",
    "        hidden_size=64,\n",
    "        num_layers=1,\n",
    "        dropout=0.0\n",
    "    ):\n",
    "        super().__init__()\n",
    "\n",
    "        self.gru = nn.GRU(\n",
    "            input_size=input_size,\n",
    "            hidden_size=hidden_size,\n",
    "            num_layers=num_layers,\n",
    "            batch_first=True,\n",
    "            dropout=dropout if num_layers > 1 else 0.0\n",
    "        )\n",
    "\n",
    "        # Sequence-level churn prediction head\n",
    "        self.classifier = nn.Sequential(\n",
    "            nn.Linear(hidden_size, 32),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(32, 1)\n",
    "        )\n",
    "\n",
    "    def forward(self, x, lengths):\n",
    "\n",
    "        # Pack sequences so padded positions are ignored\n",
    "        packed = pack_padded_sequence(\n",
    "            x,\n",
    "            lengths.cpu(),\n",
    "            batch_first=True,\n",
    "            enforce_sorted=False\n",
    "        )\n",
    "\n",
    "        _, hidden = self.gru(packed)\n",
    "\n",
    "        # Last GRU hidden state\n",
    "        embedding = hidden[-1]\n",
    "\n",
    "        # Churn logit\n",
    "        logit = self.classifier(\n",
    "            embedding\n",
    "        ).squeeze(1)\n",
    "\n",
    "        return embedding, logit\n",
    "\n",
    "\n",
    "# Create model\n",
    "gru_model = BehaviourGRU(\n",
    "    input_size=NUM_SEQUENCE_FEATURES,\n",
    "    hidden_size=64\n",
    ")\n",
    "\n",
    "print(\"GRU model created successfully.\")\n",
    "\n",
    "print(\"\\nModel architecture:\")\n",
    "print(gru_model)"
