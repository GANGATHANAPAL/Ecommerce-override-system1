   "source": [
    "# ============================================\n",
    "# FINAL EVALUATION - STEP 3\n",
    "# FROZEN CRPI VS EQUAL-WEIGHT CRPI\n",
    "# ============================================\n",
    "\n",
    "from sklearn.metrics import roc_auc_score\n",
    "from scipy.stats import spearmanr\n",
    "\n",
    "# ------------------------------------------------\n",
    "# Create equal-weight CRPI on validation\n",
    "# ------------------------------------------------\n",
    "equal_weight_crpi = (\n",
    "    crpi_validation[\"churn_norm\"]\n",
    "    + crpi_validation[\"clv_norm\"]\n",
    "    + crpi_validation[\"drift_norm\"]\n",
    ") / 3.0\n",
    "\n",
    "crpi_validation[\"equal_weight_CRPI\"] = (\n",
    "    equal_weight_crpi\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# Evaluate frozen CRPI\n",
    "# ------------------------------------------------\n",
    "frozen_crpi_auc = roc_auc_score(\n",
    "    crpi_validation[\"actual_churn\"],\n",
    "    crpi_validation[\"CRPI\"]\n",
    ")\n",
    "\n",
    "frozen_rho, frozen_p = spearmanr(\n",
    "    crpi_validation[\"CRPI\"],\n",
    "    crpi_validation[\"actual_churn\"]\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# Evaluate equal-weight CRPI\n",
    "# ------------------------------------------------\n",
    "equal_crpi_auc = roc_auc_score(\n",
    "    crpi_validation[\"actual_churn\"],\n",
    "    crpi_validation[\"equal_weight_CRPI\"]\n",
    ")\n",
    "\n",
    "equal_rho, equal_p = spearmanr(\n",
    "    crpi_validation[\"equal_weight_CRPI\"],\n",
    "    crpi_validation[\"actual_churn\"]\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# Evaluate hybrid churn alone\n",
    "# ------------------------------------------------\n",
    "hybrid_auc = roc_auc_score(\n",
    "    crpi_validation[\"actual_churn\"],\n",
    "    crpi_validation[\"final_churn_probability\"]\n",
    ")\n",
    "\n",
    "hybrid_rho, hybrid_p = spearmanr(\n",
    "    crpi_validation[\"final_churn_probability\"],\n",
    "    crpi_validation[\"actual_churn\"]\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# Results table\n",
    "# ------------------------------------------------\n",
    "comparison = pd.DataFrame([\n",
    "    {\n",
    "        \"component\": \"Hybrid churn probability\",\n",
    "        \"ROC_AUC\": hybrid_auc,\n",
    "        \"Spearman_rho\": hybrid_rho,\n",
    "        \"p_value\": hybrid_p\n",
    "    },\n",
    "    {\n",
    "        \"component\": \"Equal-weight CRPI\",\n",
    "        \"ROC_AUC\": equal_crpi_auc,\n",
    "        \"Spearman_rho\": equal_rho,\n",
    "        \"p_value\": equal_p\n",
    "    },\n",
    "    {\n",
    "        \"component\": \"Frozen weighted CRPI\",\n",
    "        \"ROC_AUC\": frozen_crpi_auc,\n",
    "        \"Spearman_rho\": frozen_rho,\n",
    "        \"p_value\": frozen_p\n",
    "    }\n",
    "])\n",
    "\n",
    "print(\"CRPI comparison on untouched validation set:\")\n",
    "display(\n",
    "    comparison.round(4)\n",
    ")\n",
    "\n",
    "# ------------------------------------------------\n",
    "# High-priority targeting\n",
    "# ------------------------------------------------\n",
    "high_threshold = (\n",
    "    crpi_validation[\"CRPI\"].quantile(0.75)\n",
    ")\n",
    "\n",
    "crpi_validation[\"retention_priority\"] = np.where(\n",
    "    crpi_validation[\"CRPI\"] >= high_threshold,\n",
    "    \"High\",\n",
    "    np.where(\n",
    "        crpi_validation[\"CRPI\"]\n",
    "        >= crpi_validation[\"CRPI\"].quantile(0.50),\n",
    "        \"Medium\",\n",
    "        \"Low\"\n",
    "    )\n",
    ")\n",
    "\n",
    "priority_results = (\n",
    "    crpi_validation\n",
    "    .groupby(\"retention_priority\")\n",
    "    .agg(\n",
    "        customers=(\"customer_unique_id\", \"count\"),\n",
    "        churned=(\"actual_churn\", \"sum\")\n",
    "    )\n",
    "    .reindex([\"High\", \"Medium\", \"Low\"])\n",
    ")\n",
    "\n",
    "priority_results[\"churn_rate\"] = (\n",
    "    priority_results[\"churned\"]\n",
    "    / priority_results[\"customers\"]\n",
    "    * 100\n",
    ").round(2)\n",
    "\n",
    "print(\"\\nFrozen-CRPI priority performance:\")\n",
    "display(priority_results)"
   ]
  },
