    "# ============================================\n",
    "# STAGE 7 - STEP 1\n",
    "# CREATE FINAL RETENTION ACTION ASSIGNMENTS\n",
    "# ============================================\n",
    "\n",
    "final_action_data = bandit_data[\n",
    "    [\n",
    "        \"customer_unique_id\",\n",
    "        \"final_churn_probability\",\n",
    "        \"CRPI\",\n",
    "        \"drift_severity\",\n",
    "        \"clv_normalized\",\n",
    "        \"retention_priority\",\n",
    "        \"linucb_action\",\n",
    "        \"linucb_reward\",\n",
    "        \"actual_retention\"\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "# Map action IDs to human-readable actions\n",
    "action_map = {\n",
    "    0: \"No intervention\",\n",
    "    1: \"Personalized recommendation\",\n",
    "    2: \"Loyalty incentive\",\n",
    "    3: \"Proactive retention offer\"\n",
    "}\n",
    "\n",
    "final_action_data[\"selected_action\"] = (\n",
    "    final_action_data[\"linucb_action\"]\n",
    "    .map(action_map)\n",
    ")\n",
    "\n",
    "# Identify whether an intervention was selected\n",
    "final_action_data[\"intervention_selected\"] = (\n",
    "    final_action_data[\"linucb_action\"] != 0\n",
    ").astype(int)\n",
    "\n",
    "print(\"Final retention action assignments created.\")\n",
    "\n",
    "print(\"\\nAction distribution:\")\n",
    "print(\n",
    "    final_action_data[\n",
    "        \"selected_action\"\n",
    "    ].value_counts()\n",
    ")\n",
    "\n",
    "print(\"\\nIntervention distribution:\")\n",
    "print(\n",
    "    final_action_data[\n",
    "        \"intervention_selected\"\n",
    "    ].value_counts()\n",
    ")\n",
    "\n",
    "print(\"\\nIntervention percentage:\")\n",
    "print(\n",
    "    (\n",
    "        final_action_data[\n",
    "            \"intervention_selected\"\n",
    "        ].mean()\n",
    "        * 100\n",
    "    ).round(2)\n",
    ")\n",
    "\n",
    "print(\"\\nSample:\")\n",
    "display(\n",
    "    final_action_data.head(15)\n",
    ")"
   ]
