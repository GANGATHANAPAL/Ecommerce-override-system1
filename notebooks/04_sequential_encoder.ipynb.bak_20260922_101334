    "# ============================================\n",
    "# STAGE 5 - STEP 5\n",
    "# CREATE FINAL RETENTION PRIORITY TIERS\n",
    "# ============================================\n",
    "\n",
    "# Percentile thresholds\n",
    "crpi_high_threshold = (\n",
    "    stage5_validation_data[\"CRPI\"].quantile(0.75)\n",
    ")\n",
    "\n",
    "crpi_medium_threshold = (\n",
    "    stage5_validation_data[\"CRPI\"].quantile(0.50)\n",
    ")\n",
    "\n",
    "print(\"Final CRPI thresholds:\")\n",
    "print(\n",
    "    \"High priority threshold:\",\n",
    "    round(crpi_high_threshold, 4)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Medium priority threshold:\",\n",
    "    round(crpi_medium_threshold, 4)\n",
    ")\n",
    "\n",
    "\n",
    "# Assign priority\n",
    "def assign_final_priority(score):\n",
    "\n",
    "    if score >= crpi_high_threshold:\n",
    "        return \"High\"\n",
    "\n",
    "    elif score >= crpi_medium_threshold:\n",
    "        return \"Medium\"\n",
    "\n",
    "    else:\n",
    "        return \"Low\"\n",
    "\n",
    "\n",
    "stage5_validation_data[\"retention_priority\"] = (\n",
    "    stage5_validation_data[\"CRPI\"]\n",
    "    .apply(assign_final_priority)\n",
    ")\n",
    "\n",
    "\n",
    "# Distribution\n",
    "print(\"\\nRetention priority distribution:\")\n",
    "\n",
    "print(\n",
