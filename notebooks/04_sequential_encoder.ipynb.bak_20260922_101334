    "\n",
    "baseline_retention_rate = (\n",
    "    bandit_data[\"actual_retention\"].mean()\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Observed baseline retention rate:\",\n",
    "    round(baseline_retention_rate, 4)\n",
    ")\n",
    "\n",
    "# --------------------------------------------\n",
    "# Simulated action response model\n",
    "# --------------------------------------------\n",
    "#\n",
    "# IMPORTANT:\n",
    "# These are simulation assumptions.\n",
    "# They are NOT measured campaign effects.\n",
    "#\n",
    "# Action order:\n",
    "# 0 = No intervention\n",
    "# 1 = Personalized recommendation\n",
    "# 2 = Loyalty incentive\n",
    "# 3 = Proactive retention offer\n",
    "# --------------------------------------------\n",
    "\n",
    "def simulated_action_lift(row, action):\n",
    "\n",
    "    churn = row[\"final_churn_probability\"]\n",
    "    crpi = row[\"CRPI\"]\n",
    "    drift = row[\"drift_severity\"]\n",
    "    clv = row[\"clv_normalized\"]\n",
    "\n",
    "    # No intervention = zero simulated lift\n",
    "    if action == 0:\n",
    "        return 0.00\n",
    "\n",
    "    # Personalized recommendation:\n",
    "    # stronger when behavioral drift is elevated\n",
    "    elif action == 1:\n",
    "        return (\n",
    "            0.08 * min(drift / 3.0, 1.0)\n",
    "        )\n",
    "\n",
    "    # Loyalty incentive:\n",
    "    # stronger for higher-value customers\n",
    "    elif action == 2:\n",
    "        return (\n",
    "            0.08 * clv\n",
    "        )\n",
    "\n",
    "    # Proactive retention:\n",
    "    # stronger when churn/CRPI are high\n",
    "    elif action == 3:\n",
    "        return (\n",
    "            0.10 * (\n",
    "                0.6 * churn\n",
    "                + 0.4 * crpi\n",
    "            )\n",
    "        )\n",
    "\n",
    "    return 0.00\n",
    "\n",
    "\n",
    "# --------------------------------------------\n",
    "# Generate simulated reward for each action\n",
    "# --------------------------------------------\n",
    "\n",
    "for action in range(4):\n",
    "\n",
    "    action_col = f\"simulated_reward_action_{action}\"\n",
    "\n",
    "    rewards = []\n",
    "\n",
    "    for _, row in bandit_data.iterrows():\n",
