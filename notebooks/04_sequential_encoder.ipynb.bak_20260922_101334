    "    dtype=np.float32\n",
    ")\n",
    "\n",
    "oof_xgb_proba = np.zeros(\n",
    "    len(rf_y_train),\n",
    "    dtype=np.float32\n",
    ")\n",
    "\n",
    "# --------------------------------------------\n",
    "# 5-fold OOF generation\n",
    "# --------------------------------------------\n",
    "\n",
    "for fold, (fold_train_idx, fold_valid_idx) in enumerate(\n",
    "    skf.split(\n",
    "        rf_X_train,\n",
    "        y_train_array\n",
    "    ),\n",
    "    start=1\n",
    "):\n",
    "\n",
    "    print(f\"\\nProcessing fold {fold}/{N_SPLITS}...\")\n",
    "\n",
    "    X_fold_train = rf_X_train.iloc[\n",
    "        fold_train_idx\n",
    "    ]\n",
    "\n",
    "    X_fold_valid = rf_X_train.iloc[\n",
    "        fold_valid_idx\n",
    "    ]\n",
    "\n",
    "    y_fold_train = rf_y_train.iloc[\n",
    "        fold_train_idx\n",
    "    ]\n",
    "\n",
    "    y_fold_valid = rf_y_train.iloc[\n",
    "        fold_valid_idx\n",
    "    ]\n",
    "\n",
    "    # ----------------------------------------\n",
    "    # RF\n",
    "    # ----------------------------------------\n",
    "\n",
    "    fold_rf = RandomForestClassifier(\n",
    "        n_estimators=300,\n",
    "        min_samples_split=5,\n",
    "        min_samples_leaf=2,\n",
    "        class_weight=\"balanced\",\n",
    "        random_state=42 + fold,\n",
    "        n_jobs=-1\n",
    "    )\n",
    "\n",
    "    fold_rf.fit(\n",
    "        X_fold_train,\n",
    "        y_fold_train\n",
    "    )\n",
    "\n",
    "    oof_rf_proba[fold_valid_idx] = (\n",
    "        fold_rf\n",
    "        .predict_proba(X_fold_valid)[:, 1]\n",
    "    )\n",
    "\n",
    "    # ----------------------------------------\n",
    "    # XGBoost\n",
    "    # ----------------------------------------\n",
    "\n",
    "    num_churn_fold = int(\n",
    "        (y_fold_train == 1).sum()\n",
    "    )\n",
    "\n",
    "    num_return_fold = int(\n",
    "        (y_fold_train == 0).sum()\n",
    "    )\n",
    "\n",
    "    fold_sample_weights = np.where(\n",
    "        y_fold_train.to_numpy() == 0,\n",
    "        num_churn_fold / num_return_fold,\n",
    "        1.0\n",
    "    )\n",
    "\n",
    "    fold_xgb = xgb.XGBClassifier(\n",
    "        n_estimators=300,\n",
    "        max_depth=4,\n",
    "        learning_rate=0.03,\n",
    "        min_child_weight=3,\n",
    "        subsample=0.8,\n",
    "        colsample_bytree=0.8,\n",
    "        objective=\"binary:logistic\",\n",
    "        eval_metric=\"logloss\",\n",
    "        random_state=42 + fold,\n",
    "        n_jobs=-1\n",
    "    )\n",
    "\n",
    "    fold_xgb.fit(\n",
    "        X_fold_train,\n",
    "        y_fold_train,\n",
    "        sample_weight=fold_sample_weights\n",
    "    )\n",
    "\n",
    "    oof_xgb_proba[fold_valid_idx] = (\n",
    "        fold_xgb\n",
    "        .predict_proba(X_fold_valid)[:, 1]\n",
    "    )\n",
