    "# ============================================\n",
    "# STAGE 5 - STEP 1\n",
    "# CALCULATE HISTORICAL CLV PROXY\n",
    "# ============================================\n",
    "\n",
    "stage5_data = hybrid_data[\n",
    "    [\n",
    "        \"customer_unique_id\",\n",
    "        \"total_spending\",\n",
    "        \"total_orders\",\n",
    "        \"customer_lifetime_days\"\n",
    "    ]\n",
    "].copy()\n",
    "\n",
    "# Historical average order value\n",
    "stage5_data[\"avg_order_value_clv\"] = (\n",
    "    stage5_data[\"total_spending\"]\n",
    "    /\n",
    "    stage5_data[\"total_orders\"]\n",
    ")\n",
    "\n",
    "# Orders per active lifetime day\n",
    "stage5_data[\"order_frequency\"] = (\n",
    "    stage5_data[\"total_orders\"]\n",
    "    /\n",
    "    stage5_data[\"customer_lifetime_days\"].clip(lower=1)\n",
    ")\n",
    "\n",
    "# Simple historical CLV proxy:\n",
    "# value per order × observed order frequency\n",
    "stage5_data[\"clv_proxy\"] = (\n",
    "    stage5_data[\"avg_order_value_clv\"]\n",
    "    *\n",
    "    stage5_data[\"order_frequency\"]\n",
    ")\n",
    "\n",
    "print(\"Historical CLV proxy created.\")\n",
    "\n",
    "print(\"\\nCLV statistics:\")\n",
    "print(\n",
    "    stage5_data[\"clv_proxy\"]\n",
    "    .describe()\n",
    "    .round(4)\n",
    ")\n",
    "\n",
    "print(\"\\nSample:\")\n",
    "display(\n",
    "    stage5_data.head(10)\n",
    ")"
