    "# ============================================\n",
    "# FINAL EVALUATION - STEP 2\n",
    "# COMPONENT-WISE PRIORITIZATION DIAGNOSTIC\n",
    "# ============================================\n",
    "\n",
    "from sklearn.metrics import roc_auc_score\n",
    "from scipy.stats import spearmanr\n",
    "\n",
    "diagnostic_metrics = {}\n",
    "\n",
    "components = {\n",
    "    \"Hybrid churn probability\": (\n",
    "        final_evaluation[\"final_churn_probability\"]\n",
