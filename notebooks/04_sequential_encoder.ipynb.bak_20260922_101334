    "# ============================================\n",
    "# STAGE 3 - STEP 2\n",
    "# CREATE EVENT-LEVEL GRU REPRESENTATIONS\n",
    "# ============================================\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from torch.nn.utils.rnn import pack_padded_sequence, pad_packed_sequence\n",
    "\n",
    "\n",
    "class BehaviourGRUWithStates(nn.Module):\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        input_size=8,\n",
    "        hidden_size=64\n",
    "    ):\n",
    "        super().__init__()\n",
    "\n",
    "        self.gru = nn.GRU(\n",
    "            input_size=input_size,\n",
    "            hidden_size=hidden_size,\n",
    "            batch_first=True\n",
    "        )\n",
    "\n",
    "        self.classifier = nn.Sequential(\n",
    "            nn.Linear(hidden_size, 32),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(32, 1)\n",
    "        )\n",
    "\n",
    "    def forward(self, x, lengths):\n",
    "\n",
    "        packed = pack_padded_sequence(\n",
    "            x,\n",
    "            lengths.cpu(),\n",
    "            batch_first=True,\n",
    "            enforce_sorted=False\n",
    "        )\n",
    "\n",
    "        packed_output, hidden = self.gru(\n",
    "            packed\n",
    "        )\n",
    "\n",
    "        # Restore padded sequence of hidden states\n",
    "        hidden_states, _ = pad_packed_sequence(\n",
    "            packed_output,\n",
    "            batch_first=True\n",
    "        )\n",
    "\n",
    "        # Final state for classification\n",
    "        final_embedding = hidden[-1]\n",
    "\n",
    "        logit = self.classifier(\n",
    "            final_embedding\n",
    "        ).squeeze(1)\n",
    "\n",
    "        return (\n",
    "            hidden_states,\n",
    "            final_embedding,\n",
    "            logit\n",
    "        )\n",
    "\n",
    "\n",
    "# Create new model\n",
    "gru_state_model = BehaviourGRUWithStates(\n",
    "    input_size=NUM_SEQUENCE_FEATURES,\n",
    "    hidden_size=64\n",
    ")\n",
    "\n",
    "# Load trained GRU weights\n",
    "gru_state_model.gru.load_state_dict(\n",
    "    gru_model.gru.state_dict()\n",
    ")\n",
    "\n",
    "gru_state_model.classifier.load_state_dict(\n",
    "    gru_model.classifier.state_dict()\n",
    ")\n",
    "\n",
    "gru_state_model = gru_state_model.to(device)\n",
    "gru_state_model.eval()\n",
    "\n",
    "print(\"Event-level GRU representation model created.\")"
   ]
