    "    ),\n",
    "    \"Final CRPI\": (\n",
    "        final_evaluation[\"CRPI\"]\n",
    "    )\n",
    "}\n",
    "\n",
    "for name, scores in components.items():\n",
    "\n",
    "    auc = roc_auc_score(\n",
    "        final_evaluation[\"actual_churn\"],\n",
    "        scores\n",
    "    )\n",
    "\n",
    "    rho, p_value = spearmanr(\n",
    "        scores,\n",
    "        final_evaluation[\"actual_churn\"]\n",
    "    )\n",
    "\n",
    "    diagnostic_metrics[name] = {\n",
    "        \"ROC_AUC\": auc,\n",
    "        \"Spearman_rho\": rho,\n",
    "        \"p_value\": p_value\n",
    "    }\n",
    "\n",
    "component_diagnostic = pd.DataFrame(\n",
