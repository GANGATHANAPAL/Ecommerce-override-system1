    "# ============================================\n",
    "# STAGE 5 - STEP 4\n",
    "# CALCULATE FINAL TDA-ARN CRPI\n",
    "# ============================================\n",
    "\n",
    "stage5_validation_data[\"CRPI\"] = (\n",
    "    stage5_validation_data[\"churn_risk_normalized\"]\n",
    "    + stage5_validation_data[\"clv_normalized\"]\n",
    "    + stage5_validation_data[\"drift_normalized\"]\n",
    ") / 3.0\n",
    "\n",
    "# Rank customers\n",
    "stage5_validation_data[\"CRPI_rank\"] = (\n",
    "    stage5_validation_data[\"CRPI\"]\n",
    "    .rank(\n",
    "        ascending=False,\n",
    "        method=\"min\"\n",
    "    )\n",
    "    .astype(int)\n",
    ")\n",
    "\n",
    "stage5_validation_data = (\n",
    "    stage5_validation_data\n",
    "    .sort_values(\n",
    "        \"CRPI\",\n",
    "        ascending=False\n",
    "    )\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "print(\"Final TDA-ARN CRPI calculated successfully.\")\n",
    "\n",
    "print(\"\\nCRPI statistics:\")\n",
