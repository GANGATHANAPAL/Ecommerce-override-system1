    "# ============================================\n",
    "# STAGE 8 - STEP 1\n",
    "# OUTCOME LOGGING & FEEDBACK RECORD\n",
    "# ============================================\n",
    "\n",
    "feedback_log = final_action_data.copy()\n",
    "\n",
    "# Add the simulated reward generated by the bandit\n",
    "feedback_log[\"simulated_reward\"] = (\n",
    "    feedback_log[\"linucb_reward\"]\n",
    ")\n",
    "\n",
    "# Record whether the policy received a positive\n",
    "# simulated reward\n",
    "feedback_log[\"positive_reward\"] = (\n",
    "    feedback_log[\"simulated_reward\"] > 0\n",
    ").astype(int)\n",
    "\n",
    "# Cumulative reward over the sequential simulation\n",
    "feedback_log[\"cumulative_reward\"] = (\n",
    "    feedback_log[\"simulated_reward\"]\n",
    "    .cumsum()\n",
    ")\n",
    "\n",
