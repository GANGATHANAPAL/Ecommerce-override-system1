    "# ============================================\n",
    "# STAGE 3 - STEP 5\n",
    "# PAGE-HINKLEY DRIFT DETECTOR\n",
    "# ============================================\n",
    "\n",
    "class PageHinkley:\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        delta=0.01,\n",
    "        threshold=5.0,\n",
    "        alpha=0.999\n",
    "    ):\n",
    "        self.delta = delta\n",
    "        self.threshold = threshold\n",
    "        self.alpha = alpha\n",
    "\n",
    "        self.mean = 0.0\n",
    "        self.sum = 0.0\n",
    "        self.min_sum = 0.0\n",
    "        self.count = 0\n",
    "\n",
    "    def update(self, value):\n",
    "\n",
    "        self.count += 1\n",
    "\n",
    "        # Update running mean\n",
    "        self.mean = (\n",
    "            self.alpha * self.mean\n",
    "            + (1 - self.alpha) * value\n",
    "        )\n",
    "\n",
    "        # Page-Hinkley cumulative deviation\n",
    "        self.sum += (\n",
    "            value\n",
    "            - self.mean\n",
    "            - self.delta\n",
    "        )\n",
    "\n",
    "        # Track minimum cumulative sum\n",
    "        self.min_sum = min(\n",
    "            self.min_sum,\n",
    "            self.sum\n",
    "        )\n",
    "\n",
    "        # Drift condition\n",
    "        drift = (\n",
    "            self.sum - self.min_sum\n",
    "        ) > self.threshold\n",
    "\n",
    "        return drift\n",
    "\n",
    "\n",
    "# --------------------------------------------\n",
    "# Run detector over chronological stream\n",
    "# --------------------------------------------\n",
    "\n",
    "ph_detector = PageHinkley(\n",
    "    delta=0.01,\n",
    "    threshold=5.0,\n",
    "    alpha=0.999\n",
    ")\n",
    "\n",
    "drift_flags = []\n",
    "\n",
    "for value in embedding_drift_data[\n",
    "    \"embedding_drift_score\"\n",
    "]:\n",
    "\n",
    "    drift_flags.append(\n",
    "        ph_detector.update(value)\n",
    "    )\n",
    "\n",
    "embedding_drift_data[\"page_hinkley_drift\"] = (\n",
    "    drift_flags\n",
    ")\n",
    "\n",
    "print(\"Page-Hinkley drift detection completed.\")\n",
    "\n",
    "print(\"\\nTotal observations:\")\n",
    "print(\n",
    "    len(embedding_drift_data)\n",
    ")\n",
    "\n",
    "print(\"\\nDrift detections:\")\n",
    "print(\n",
    "    embedding_drift_data[\n",
    "        \"page_hinkley_drift\"\n",
    "    ].value_counts()\n",
    ")\n",
    "\n",
    "print(\"\\nDrift detection percentage:\")\n",
    "print(\n",
    "    (\n",
    "        embedding_drift_data[\n",
    "            \"page_hinkley_drift\"\n",
    "        ]\n",
    "        .mean()\n",
    "        * 100\n",
    "    ).round(2)\n",
    ")\n",
