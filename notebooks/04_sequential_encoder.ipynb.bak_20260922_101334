    "# ============================================\n",
    "# STAGE 6 - STEP 4\n",
    "# IMPLEMENT LINUCB OFFLINE\n",
    "# ============================================\n",
    "\n",
    "import numpy as np\n",
    "\n",
    "class LinUCB:\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        n_actions,\n",
    "        n_features,\n",
    "        alpha=1.0\n",
    "    ):\n",
    "        self.n_actions = n_actions\n",
    "        self.n_features = n_features\n",
    "        self.alpha = alpha\n",
    "\n",
    "        self.A = [\n",
    "            np.eye(n_features)\n",
    "            for _ in range(n_actions)\n",
    "        ]\n",
    "\n",
    "        self.b = [\n",
    "            np.zeros(n_features)\n",
    "            for _ in range(n_actions)\n",
    "        ]\n",
    "\n",
    "    def select_action(self, context):\n",
    "\n",
    "        context = np.asarray(\n",
    "            context,\n",
    "            dtype=np.float64\n",
    "        )\n",
    "\n",
    "        scores = []\n",
    "\n",
    "        for action in range(\n",
    "            self.n_actions\n",
    "        ):\n",
    "\n",
    "            A_inv = np.linalg.inv(\n",
    "                self.A[action]\n",
    "            )\n",
    "\n",
    "            theta = (\n",
    "                A_inv\n",
    "                @ self.b[action]\n",
    "            )\n",
    "\n",
    "            exploitation = (\n",
    "                theta @ context\n",
    "            )\n",
    "\n",
    "            exploration = (\n",
    "                self.alpha\n",
    "                * np.sqrt(\n",
    "                    context\n",
    "                    @ A_inv\n",
    "                    @ context\n",
    "                )\n",
    "            )\n",
    "\n",
    "            scores.append(\n",
    "                exploitation\n",
    "                + exploration\n",
    "            )\n",
    "\n",
    "        return int(\n",
    "            np.argmax(scores)\n",
    "        )\n",
    "\n",
    "    def update(\n",
    "        self,\n",
    "        action,\n",
    "        context,\n",
    "        reward\n",
    "    ):\n",
    "\n",
    "        context = np.asarray(\n",
    "            context,\n",
    "            dtype=np.float64\n",
    "        )\n",
    "\n",
    "        self.A[action] += np.outer(\n",
    "            context,\n",
    "            context\n",
    "        )\n",
    "\n",
    "        self.b[action] += (\n",
    "            reward * context\n",
    "        )\n",
    "\n",
    "\n",
    "# --------------------------------------------\n",
    "# Initialize bandit\n",
    "# --------------------------------------------\n",
    "\n",
    "n_actions = len(\n",
    "    retention_actions\n",
    ")\n",
    "\n",
    "n_features = bandit_context.shape[1]\n",
    "\n",
    "linucb = LinUCB(\n",
    "    n_actions=n_actions,\n",
    "    n_features=n_features,\n",
    "    alpha=1.0\n",
    ")\n",
    "\n",
    "print(\"LinUCB initialized.\")\n",
    "\n",
    "print(\n",
    "    \"Actions:\",\n",
    "    n_actions\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Context features:\",\n",
    "    n_features\n",
    ")\n",
    "\n",
    "# --------------------------------------------\n",
    "# Offline bandit simulation\n",
    "# --------------------------------------------\n",
    "\n",
    "selected_actions = []\n",
    "observed_rewards = []\n",
    "\n",
    "for i in range(\n",
    "    len(bandit_data)\n",
    "):\n",
    "\n",
    "    context = bandit_context[i]\n",
    "\n",
    "    # Select action\n",
    "    action = linucb.select_action(\n",
    "        context\n",
    "    )\n",
    "\n",
    "    # Obtain simulated reward\n",
    "    reward_column = (\n",
    "        f\"simulated_reward_action_{action}\"\n",
    "    )\n",
    "\n",
    "    reward = int(\n",
    "        bandit_data.iloc[i][\n",
    "            reward_column\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    # Update policy\n",
    "    linucb.update(\n",
    "        action,\n",
    "        context,\n",
    "        reward\n",
    "    )\n",
    "\n",
    "    selected_actions.append(\n",
    "        action\n",
    "    )\n",
    "\n",
    "    observed_rewards.append(\n",
    "        reward\n",
    "    )\n",
    "\n",
    "bandit_data[\"linucb_action\"] = (\n",
