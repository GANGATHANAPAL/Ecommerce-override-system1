    "# ============================================\n",
    "# STAGE 6 - STEP 5\n",
    "# EVALUATE LINUCB POLICY\n",
    "# ============================================\n",
    "\n",
    "# --------------------------------------------\n",
    "# Fixed-action rewards\n",
    "# --------------------------------------------\n",
    "\n",
    "fixed_action_rewards = {}\n",
    "\n",
    "for action, name in enumerate(retention_actions):\n",
    "\n",
    "    reward_column = (\n",
    "        f\"simulated_reward_action_{action}\"\n",
    "    )\n",
    "\n",
    "    fixed_action_rewards[name] = (\n",
    "        bandit_data[reward_column].mean()\n",
    "    )\n",
    "\n",
    "print(\"Fixed-action simulated rewards:\")\n",
    "for name, reward in fixed_action_rewards.items():\n",
    "    print(\n",
    "        f\"{name}: {reward:.4f}\"\n",
    "    )\n",
    "\n",
    "# --------------------------------------------\n",
    "# Best fixed action\n",
    "# --------------------------------------------\n",
    "\n",
    "best_fixed_action = max(\n",
    "    fixed_action_rewards,\n",
    "    key=fixed_action_rewards.get\n",
    ")\n",
    "\n",
    "best_fixed_reward = (\n",
    "    fixed_action_rewards[\n",
    "        best_fixed_action\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(\"\\nBest fixed action:\")\n",
    "print(best_fixed_action)\n",
    "\n",
    "print(\n",
    "    \"Best fixed reward:\",\n",
    "    round(best_fixed_reward, 4)\n",
    ")\n",
    "\n",
    "# --------------------------------------------\n",
    "# LinUCB reward\n",
    "# --------------------------------------------\n",
    "\n",
    "linucb_reward = (\n",
    "    bandit_data[\"linucb_reward\"].mean()\n",
    ")\n",
    "\n",
    "print(\"\\nLinUCB reward:\")\n",
    "print(round(linucb_reward, 4))\n",
    "\n",
    "# --------------------------------------------\n",
    "# Relative comparison\n",
    "# --------------------------------------------\n",
    "\n",
    "print(\"\\nLinUCB vs best fixed action:\")\n",
    "\n",
    "if best_fixed_reward != 0:\n",
    "\n",
    "    relative_difference = (\n",
    "        (linucb_reward - best_fixed_reward)\n",
