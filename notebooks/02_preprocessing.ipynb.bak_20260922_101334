    "# ============================================\n",
    "# STEP 27: CALCULATE CORRECTED CRPI\n",
    "# ============================================\n",
    "\n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "\n",
    "corrected_crpi_data = corrected_crpi_data.copy()\n",
    "\n",
    "# --------------------------------------------\n",
    "# Normalize churn probability\n",
    "# --------------------------------------------\n",
    "\n",
    "churn_scaler_corrected = MinMaxScaler()\n",
    "\n",
    "corrected_crpi_data[\"churn_risk_normalized\"] = (\n",
    "    churn_scaler_corrected.fit_transform(\n",
    "        corrected_crpi_data[[\"churn_probability\"]]\n",
    "    ).ravel()\n",
    ")\n",
    "\n",
    "# --------------------------------------------\n",
    "# Normalize behavior drift\n",
    "# --------------------------------------------\n",
    "\n",
    "drift_scaler_corrected = MinMaxScaler()\n",
    "\n",
    "corrected_crpi_data[\"drift_risk_normalized\"] = (\n",
    "    drift_scaler_corrected.fit_transform(\n",
    "        corrected_crpi_data[[\"behavior_drift_score\"]]\n",
    "    ).ravel()\n",
    ")\n",
    "\n",
    "# --------------------------------------------\n",
    "# CRPI\n",
    "# --------------------------------------------\n",
    "\n",
    "corrected_crpi_data[\"CRPI\"] = (\n",
    "    0.5 * corrected_crpi_data[\"churn_risk_normalized\"]\n",
    "    +\n",
    "    0.5 * corrected_crpi_data[\"drift_risk_normalized\"]\n",
    ")\n",
    "\n",
    "# --------------------------------------------\n",
    "# Rank\n",
    "# --------------------------------------------\n",
    "\n",
    "corrected_crpi_data[\"CRPI_rank\"] = (\n",
    "    corrected_crpi_data[\"CRPI\"]\n",
    "    .rank(\n",
    "        ascending=False,\n",
    "        method=\"min\"\n",
    "    )\n",
    "    .astype(int)\n",
    ")\n",
    "\n",
    "corrected_crpi_data = (\n",
    "    corrected_crpi_data\n",
    "    .sort_values(\"CRPI\", ascending=False)\n",
    "    .reset_index(drop=True)\n",
    ")\n",
