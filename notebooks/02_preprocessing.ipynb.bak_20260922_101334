    "# ============================================\n",
    "# STEP 31: CREATE BASELINE RECOMMENDATION\n",
    "# ============================================\n",
    "\n",
    "recommendation_data = corrected_crpi_data.copy()\n",
    "\n",
    "def baseline_recommendation(row):\n",
    "    if row[\"churn_probability\"] >= 0.8:\n",
    "        return \"Standard product recommendation\"\n",
    "    elif row[\"behavior_drift_score\"] >= 2.0:\n",
    "        return \"Recent-behavior product recommendation\"\n",
    "    else:\n",
    "        return \"General product recommendation\"\n",
    "\n",
    "recommendation_data[\"baseline_recommendation\"] = (\n",
    "    recommendation_data.apply(\n",
    "        baseline_recommendation,\n",
    "        axis=1\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"Baseline recommendations created.\")\n",
    "\n",
    "print(\"\\nRecommendation distribution:\")\n",
