    "print(\"Corrected CRPI thresholds:\")\n",
    "print(\n",
    "    \"High priority threshold:\",\n",
    "    round(corrected_high_threshold, 4)\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"Medium priority threshold:\",\n",
    "    round(corrected_medium_threshold, 4)\n",
    ")\n",
    "\n",
    "\n",
    "# Assign priority\n",
    "def assign_corrected_priority(score):\n",
    "    if score >= corrected_high_threshold:\n",
    "        return \"High\"\n",
    "    elif score >= corrected_medium_threshold:\n",
    "        return \"Medium\"\n",
    "    else:\n",
    "        return \"Low\"\n",
    "\n",
    "\n",
    "corrected_crpi_data[\"retention_priority\"] = (\n",
    "    corrected_crpi_data[\"CRPI\"]\n",
