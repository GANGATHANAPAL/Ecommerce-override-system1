    "# ============================================\n",
    "# STEP 18L: CALCULATE BEHAVIOR CHANGES\n",
    "# ============================================\n",
    "\n",
    "# Separate early and recent profiles\n",
    "early_profile = (\n",
    "    behavior_profile[\n",
    "        behavior_profile[\"behavior_period\"] == \"early\"\n",
    "    ]\n",
    "    .drop(columns=[\"behavior_period\"])\n",
    "    .set_index(\"customer_unique_id\")\n",
    ")\n",
    "\n",
    "recent_profile = (\n",
    "    behavior_profile[\n",
    "        behavior_profile[\"behavior_period\"] == \"recent\"\n",
    "    ]\n",
    "    .drop(columns=[\"behavior_period\"])\n",
    "    .set_index(\"customer_unique_id\")\n",
    ")\n",
    "\n",
    "# Make sure both profiles contain the same customers\n",
    "common_customers = (\n",
    "    early_profile.index\n",
    "    .intersection(recent_profile.index)\n",
    ")\n",
    "\n",
    "early_profile = early_profile.loc[common_customers]\n",
    "recent_profile = recent_profile.loc[common_customers]\n",
    "\n",
    "# Features for behavior comparison\n",
    "behavior_features = [\n",
    "    \"orders\",\n",
    "    \"items\",\n",
    "    \"spending\",\n",
    "    \"products\",\n",
    "    \"sellers\",\n",
    "    \"payment\",\n",
    "    \"installments\",\n",
    "    \"review\"\n",
    "]\n",
    "\n",
    "# Calculate percentage/relative change\n",
    "behavior_changes = pd.DataFrame(index=common_customers)\n",
    "\n",
    "for feature in behavior_features:\n",
    "\n",
    "    early = early_profile[feature]\n",
    "    recent = recent_profile[feature]\n",
    "\n",
    "    # Relative change\n",
    "    behavior_changes[f\"{feature}_change\"] = (\n",
    "        (recent - early) /\n",
    "        (early.abs() + 1e-6)\n",
    "    )\n",
    "\n",
    "# Restore customer ID as column\n",
    "behavior_changes = behavior_changes.reset_index()\n",
    "\n",
    "print(\"Behavior changes created successfully.\")\n",
    "\n",
    "print(\"\\nShape:\")\n",
    "print(behavior_changes.shape)\n",
    "\n",
    "print(\"\\nColumns:\")\n",
    "print(behavior_changes.columns.tolist())\n",
    "\n",
    "print(\"\\nSample:\")\n",
    "display(behavior_changes.head())"
   ]
