    "# ============================================\n",
    "# STEP 18S: CALCULATE CRPI\n",
    "# ============================================\n",
    "\n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "\n",
    "# Create a copy\n",
    "crpi_data = crpi_data.copy()\n",
    "\n",
    "# --------------------------------------------\n",
    "# 1. Normalize churn probability\n",
    "# --------------------------------------------\n",
    "\n",
    "churn_scaler = MinMaxScaler()\n",
    "\n",
    "crpi_data[\"churn_risk_normalized\"] = (\n",
    "    churn_scaler.fit_transform(\n",
    "        crpi_data[[\"churn_probability\"]]\n",
    "    ).ravel()\n",
    ")\n",
    "\n",
    "# --------------------------------------------\n",
    "# 2. Normalize behavior drift\n",
    "# --------------------------------------------\n",
    "\n",
    "drift_scaler = MinMaxScaler()\n",
    "\n",
    "crpi_data[\"drift_risk_normalized\"] = (\n",
    "    drift_scaler.fit_transform(\n",
    "        crpi_data[[\"behavior_drift_score\"]]\n",
    "    ).ravel()\n",
    ")\n",
    "\n",
    "# --------------------------------------------\n",
    "# 3. Calculate CRPI\n",
    "# --------------------------------------------\n",
    "\n",
    "crpi_data[\"CRPI\"] = (\n",
    "    0.5 * crpi_data[\"churn_risk_normalized\"]\n",
    "    +\n",
    "    0.5 * crpi_data[\"drift_risk_normalized\"]\n",
    ")\n",
    "\n",
    "# --------------------------------------------\n",
    "# 4. Rank customers\n",
    "# --------------------------------------------\n",
    "\n",
    "crpi_data[\"CRPI_rank\"] = (\n",
    "    crpi_data[\"CRPI\"]\n",
    "    .rank(\n",
    "        ascending=False,\n",
    "        method=\"min\"\n",
    "    )\n",
    "    .astype(int)\n",
    ")\n",
    "\n",
    "# Sort by priority\n",
    "crpi_data = crpi_data.sort_values(\n",
    "    \"CRPI\",\n",
    "    ascending=False\n",
    ").reset_index(drop=True)\n",
    "\n",
    "print(\"CRPI calculated successfully.\")\n",
    "\n",
    "print(\"\\nShape:\")\n",
    "print(crpi_data.shape)\n",
    "\n",
    "print(\"\\nCRPI statistics:\")\n",
    "print(\n",
    "    crpi_data[\"CRPI\"]\n",
    "    .describe()\n",
    "    .round(4)\n",
    ")\n",
    "\n",
    "print(\"\\nTop 10 retention-priority customers:\")\n",
    "\n",
    "display(\n",
    "    crpi_data[\n",
    "        [\n",
    "            \"customer_unique_id\",\n",
    "            \"churn_probability\",\n",
    "            \"behavior_drift_score\",\n",
    "            \"high_drift\",\n",
    "            \"churn_risk_normalized\",\n",
    "            \"drift_risk_normalized\",\n",
    "            \"CRPI\",\n",
    "            \"CRPI_rank\"\n",
    "        ]\n",
    "    ].head(10)\n",
    ")"
