    "# ============================================\n",
    "# STEP 18C: CREATE EARLIER & RECENT PROFILES\n",
    "# ============================================\n",
    "\n",
    "behavior_columns = [\n",
    "    \"total_items\",\n",
    "    \"total_spending_items\",\n",
    "    \"total_products\",\n",
    "    \"total_sellers\",\n",
    "    \"total_payment\",\n",
    "    \"avg_installments\",\n",
    "    \"avg_review_score\"\n",
    "]\n",
    "\n",
    "# --------------------------------------------\n",
    "# Earlier behavior\n",
    "# --------------------------------------------\n",
    "\n",
    "earlier_profile = (\n",
    "    earlier_orders\n",
    "    .groupby(\"customer_unique_id\")\n",
    "    .agg(\n",
    "        earlier_orders=(\"order_id\", \"nunique\"),\n",
    "        earlier_items=(\"total_items\", \"sum\"),\n",
    "        earlier_spending=(\"total_spending_items\", \"sum\"),\n",
    "        earlier_products=(\"total_products\", \"sum\"),\n",
    "        earlier_sellers=(\"total_sellers\", \"sum\"),\n",
    "        earlier_payment=(\"total_payment\", \"sum\"),\n",
    "        earlier_installments=(\"avg_installments\", \"mean\"),\n",
    "        earlier_review=(\"avg_review_score\", \"mean\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "# --------------------------------------------\n",
    "# Recent behavior\n",
    "# --------------------------------------------\n",
    "\n",
    "recent_profile = (\n",
    "    recent_orders\n",
    "    .groupby(\"customer_unique_id\")\n",
    "    .agg(\n",
    "        recent_orders=(\"order_id\", \"nunique\"),\n",
    "        recent_items=(\"total_items\", \"sum\"),\n",
    "        recent_spending=(\"total_spending_items\", \"sum\"),\n",
    "        recent_products=(\"total_products\", \"sum\"),\n",
    "        recent_sellers=(\"total_sellers\", \"sum\"),\n",
    "        recent_payment=(\"total_payment\", \"sum\"),\n",
    "        recent_installments=(\"avg_installments\", \"mean\"),\n",
    "        recent_review=(\"avg_review_score\", \"mean\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "print(\"Earlier profile:\", earlier_profile.shape)\n",
    "print(\"Recent profile:\", recent_profile.shape)\n",
    "\n",
    "print(\"\\nEarlier profile:\")\n",
    "display(earlier_profile.head())\n",
    "\n",
    "print(\"\\nRecent profile:\")\n",
    "display(recent_profile.head())"
   ]
  },
