    "# ============================================\n",
    "# STEP 18T: CREATE RETENTION PRIORITY TIERS\n",
    "# ============================================\n",
    "\n",
    "# Calculate CRPI percentile thresholds\n",
    "high_threshold = crpi_data[\"CRPI\"].quantile(0.75)\n",
    "medium_threshold = crpi_data[\"CRPI\"].quantile(0.50)\n",
    "\n",
    "print(\"CRPI thresholds:\")\n",
    "print(\"High priority threshold:\", round(high_threshold, 4))\n",
    "print(\"Medium priority threshold:\", round(medium_threshold, 4))\n",
    "\n",
    "# Assign retention priority\n",
    "def assign_priority(score):\n",
    "    if score >= high_threshold:\n",
    "        return \"High\"\n",
    "    elif score >= medium_threshold:\n",
    "        return \"Medium\"\n",
    "    else:\n",
    "        return \"Low\"\n",
    "\n",
    "crpi_data[\"retention_priority\"] = (\n",
    "    crpi_data[\"CRPI\"]\n",
    "    .apply(assign_priority)\n",
    ")\n",
    "\n",
    "# Check distribution\n",
    "print(\"\\nRetention priority distribution:\")\n",
    "print(\n",
    "    crpi_data[\"retention_priority\"]\n",
    "    .value_counts()\n",
    ")\n",
    "\n",
    "print(\"\\nRetention priority percentage:\")\n",
    "print(\n",
