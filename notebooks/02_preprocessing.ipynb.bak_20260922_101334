    "# ============================================\n",
    "# STEP 18E: CALCULATE BEHAVIOR CHANGES\n",
    "# ============================================\n",
    "\n",
    "drift_features = [\n",
    "    \"orders\",\n",
    "    \"items\",\n",
    "    \"spending\",\n",
    "    \"products\",\n",
    "    \"sellers\",\n",
    "    \"payment\",\n",
    "    \"installments\",\n",
    "    \"review\"\n",
    "]\n",
    "\n",
    "for feature in drift_features:\n",
    "    earlier_col = f\"earlier_{feature}\"\n",
    "    recent_col = f\"recent_{feature}\"\n",
    "    change_col = f\"{feature}_change\"\n",
    "\n",
    "    drift_data[change_col] = (\n",
    "        drift_data[recent_col] - drift_data[earlier_col]\n",
    "    ) / (\n",
    "        drift_data[earlier_col].abs() + 1e-6\n",
    "    )\n",
    "\n",
    "print(\"Behavior change features created.\")\n",
    "\n",
    "change_columns = [\n",
    "    f\"{feature}_change\"\n",
    "    for feature in drift_features\n",
    "]\n",
    "\n",
    "print(\"\\nChange columns:\")\n",
    "print(change_columns)\n",
    "\n",
    "print(\"\\nSample behavior changes:\")\n",
    "display(\n",
    "    drift_data[\n",
    "        [\"customer_unique_id\"] + change_columns\n",
    "    ].head()\n",
    ")"
   ]
