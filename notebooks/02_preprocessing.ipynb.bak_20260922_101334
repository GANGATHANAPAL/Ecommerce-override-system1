    "# ============================================\n",
    "# STEP 32: DYNAMIC RECOMMENDATION OVERRIDE\n",
    "# ============================================\n",
    "\n",
    "def apply_dynamic_override(row):\n",
    "\n",
    "    # High priority + high behavioral drift\n",
    "    if (\n",
    "        row[\"retention_priority\"] == \"High\"\n",
    "        and row[\"high_drift\"] == 1\n",
    "    ):\n",
    "        return \"Retention intervention\"\n",
    "\n",
    "    # High priority but normal drift\n",
    "    elif row[\"retention_priority\"] == \"High\":\n",
    "        return \"Personalized retention offer\"\n",
    "\n",
    "    # Medium priority + high drift\n",
    "    elif (\n",
    "        row[\"retention_priority\"] == \"Medium\"\n",
    "        and row[\"high_drift\"] == 1\n",
    "    ):\n",
    "        return \"Recent-behavior retention recommendation\"\n",
    "\n",
    "    # Otherwise keep the normal recommendation\n",
    "    else:\n",
    "        return row[\"baseline_recommendation\"]\n",
    "\n",
    "\n",
    "recommendation_data[\"final_recommendation\"] = (\n",
    "    recommendation_data.apply(\n",
    "        apply_dynamic_override,\n",
    "        axis=1\n",
    "    )\n",
    ")\n",
    "\n",
    "# Check whether override occurred\n",
    "recommendation_data[\"override_triggered\"] = (\n",
    "    recommendation_data[\"final_recommendation\"]\n",
    "    != recommendation_data[\"baseline_recommendation\"]\n",
    ").astype(int)\n",
    "\n",
    "print(\"Dynamic recommendation override completed.\")\n",
    "\n",
    "print(\"\\nFinal recommendation distribution:\")\n",
    "print(\n",
    "    recommendation_data[\"final_recommendation\"]\n",
    "    .value_counts()\n",
    ")\n",
    "\n",
    "print(\"\\nOverride distribution:\")\n",
    "print(\n",
    "    recommendation_data[\"override_triggered\"]\n",
    "    .value_counts()\n",
    ")\n",
    "\n",
    "print(\"\\nOverride percentage:\")\n",
    "print(\n",
    "    recommendation_data[\"override_triggered\"]\n",
    "    .mean() * 100\n",
    ")\n",
    "\n",
    "print(\"\\nSample:\")\n",
    "display(\n",
    "    recommendation_data[\n",
