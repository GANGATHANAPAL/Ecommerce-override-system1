    "# ============================================\n",
    "# STEP 3: CUSTOMER MAPPING + ORDER AGGREGATION\n",
    "# ============================================\n",
    "\n",
    "# --------------------------------------------\n",
    "# 3.1 Map customer_id -> customer_unique_id\n",
    "# --------------------------------------------\n",
    "\n",
    "customer_mapping = customers[\n",
    "    [\"customer_id\", \"customer_unique_id\"]\n",
    "].drop_duplicates()\n",
    "\n",
    "delivered_orders = delivered_orders.merge(\n",
    "    customer_mapping,\n",
    "    on=\"customer_id\",\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "print(\"Customer mapping completed.\")\n",
    "print(\"Delivered orders:\", delivered_orders.shape)\n",
    "print(\n",
    "    \"Missing customer_unique_id:\",\n",
    "    delivered_orders[\"customer_unique_id\"].isna().sum()\n",
    ")\n",
    "\n",
    "\n",
    "# --------------------------------------------\n",
    "# 3.2 Aggregate order items\n",
    "# --------------------------------------------\n",
    "\n",
    "order_items_agg = (\n",
    "    order_items\n",
    "    .groupby(\"order_id\")\n",
    "    .agg(\n",
    "        total_items=(\"order_item_id\", \"count\"),\n",
    "        total_spending_items=(\"price\", \"sum\"),\n",
    "        total_products=(\"product_id\", \"nunique\"),\n",
    "        total_sellers=(\"seller_id\", \"nunique\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "print(\"\\nOrder items aggregation:\", order_items_agg.shape)\n",
    "\n",
    "\n",
    "# --------------------------------------------\n",
    "# 3.3 Aggregate payments\n",
    "# --------------------------------------------\n",
    "\n",
    "payments_agg = (\n",
    "    payments\n",
    "    .groupby(\"order_id\")\n",
    "    .agg(\n",
    "        total_payment=(\"payment_value\", \"sum\"),\n",
    "        avg_installments=(\"payment_installments\", \"mean\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "print(\"Payments aggregation:\", payments_agg.shape)\n",
    "\n",
    "\n",
    "# --------------------------------------------\n",
    "# 3.4 Aggregate reviews\n",
    "# --------------------------------------------\n",
    "\n",
    "reviews_agg = (\n",
    "    reviews\n",
    "    .groupby(\"order_id\")\n",
    "    .agg(\n",
    "        avg_review_score=(\"review_score\", \"mean\")\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "print(\"Reviews aggregation:\", reviews_agg.shape)\n",
    "\n",
    "\n",
    "# --------------------------------------------\n",
    "# 3.5 Merge everything at order level\n",
    "# --------------------------------------------\n",
    "\n",
    "order_level = delivered_orders.merge(\n",
    "    order_items_agg,\n",
    "    on=\"order_id\",\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "order_level = order_level.merge(\n",
    "    payments_agg,\n",
    "    on=\"order_id\",\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "order_level = order_level.merge(\n",
    "    reviews_agg,\n",
    "    on=\"order_id\",\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "\n",
    "# --------------------------------------------\n",
    "# 3.6 Handle missing values\n",
    "# --------------------------------------------\n",
    "\n",
    "order_level[\"total_items\"] = (\n",
    "    order_level[\"total_items\"].fillna(0)\n",
    ")\n",
    "\n",
    "order_level[\"total_products\"] = (\n",
    "    order_level[\"total_products\"].fillna(0)\n",
    ")\n",
    "\n",
    "order_level[\"total_sellers\"] = (\n",
    "    order_level[\"total_sellers\"].fillna(0)\n",
    ")\n",
    "\n",
    "order_level[\"total_spending_items\"] = (\n",
    "    order_level[\"total_spending_items\"].fillna(0)\n",
    ")\n",
    "\n",
    "order_level[\"total_payment\"] = (\n",
    "    order_level[\"total_payment\"].fillna(0)\n",
    ")\n",
    "\n",
    "order_level[\"avg_installments\"] = (\n",
    "    order_level[\"avg_installments\"].fillna(0)\n",
    ")\n",
    "\n",
    "\n",
    "# --------------------------------------------\n",
    "# 3.7 Convert date columns\n",
