    "# ============================================\n",
    "# STEP 18J: CREATE CUSTOMER-SPECIFIC\n",
    "# EARLY AND RECENT PERIODS\n",
    "# ============================================\n",
    "\n",
    "# Sort orders chronologically for each customer\n",
    "repeat_orders = repeat_orders.sort_values(\n",
    "    [\"customer_unique_id\", \"order_purchase_timestamp\"]\n",
    ").copy()\n",
    "\n",
    "# Assign sequential order number\n",
    "repeat_orders[\"customer_order_number\"] = (\n",
    "    repeat_orders\n",
    "    .groupby(\"customer_unique_id\")\n",
    "    .cumcount() + 1\n",
    ")\n",
    "\n",
    "# Total number of orders for each customer\n",
    "repeat_orders[\"customer_total_orders\"] = (\n",
    "    repeat_orders\n",
    "    .groupby(\"customer_unique_id\")[\"order_id\"]\n",
    "    .transform(\"count\")\n",
    ")\n",
    "\n",
    "# Calculate midpoint\n",
    "repeat_orders[\"midpoint\"] = (\n",
    "    repeat_orders[\"customer_total_orders\"] / 2\n",
    ")\n",
    "\n",
    "# Early vs recent\n",
    "repeat_orders[\"behavior_period\"] = np.where(\n",
    "    repeat_orders[\"customer_order_number\"]\n",
    "    <= repeat_orders[\"midpoint\"],\n",
    "    \"early\",\n",
    "    \"recent\"\n",
    ")\n",
    "\n",
    "print(\"Behavior periods assigned successfully.\")\n",
    "\n",
    "print(\"\\nPeriod distribution:\")\n",
    "print(\n",
    "    repeat_orders[\"behavior_period\"]\n",
    "    .value_counts()\n",
    ")\n",
    "\n",
    "print(\"\\nSample:\")\n",
    "display(\n",
    "    repeat_orders[\n",
    "        [\n",
    "            \"customer_unique_id\",\n",
    "            \"order_purchase_timestamp\",\n",
    "            \"customer_order_number\",\n",
    "            \"customer_total_orders\",\n",
    "            \"behavior_period\"\n",
    "        ]\n",
    "    ].head(15)\n",
    ")"
   ]
